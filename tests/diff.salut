-                params.append(f"{p_name}: {p_type}")
-
-            param_str = ", ".join(params)
-
-            signatures.append(f"# {desc}\n{name}({param_str})")
-
-        return "\n\n".join(signatures)
-
-    def __str__(self) -> str:
-        return self.final_prompt
